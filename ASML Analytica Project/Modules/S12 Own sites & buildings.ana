NodeSize: 64,24
WindState: 2,0,0,720,350
ValueState: 2,40,50,400,300,0,MIDM
Aliases: FormNode Fo1940195411

Alias Al1161629779
Title: CRE Emissions Intervention Mod.
NodeLocation: 576,48,1
NodeSize: 64,40
Original: CRE_Emissions_Interv

Variable S12_Ext_Scenario_Com
Title: S12 Ext Scenario Composition
Definition: IF @S12_Ext_Scenario<=Size(S12_Interventions)~
	THEN ~
		IF Time >= Effect_Start ~
			THEN S12_Ext_Scenario=S12_Interventions ~
		ELSE 0~
ELSE S12_Scenario[Scenario=S12_Ext_Scenario]
NodeLocation: 328,160,1
NodeSize: 64,32
WindState: 2,0,0,720,350
ValueState: 2,372,378,1205,389,,MIDM
ReformVal: [S12_Interventions,S12_Ext_Scenario]
Att__TotalsIndex: []
Att_ResultSliceState: [Time,11,S12_Ext_Scenario,1,S12_Interventions,2]

Variable CRE_vs_non_CRE
Title: CRE vs non-CRE
Definition: IF S12_Ext_Scenario_Com[S12_Interventions='Masteprlan CRE']~
	THEN CRE_Emissions~
ELSE Non_CRE_Emissions;
NodeLocation: 576,160,1
NodeSize: 64,24
WindState: 2,0,0,720,350
ValueState: 2,148,154,1136,444,,MIDM
Att__TotalsIndex: []
