NodeBorderColor OF Text := Theme_Info[Themes=Diagram_Colors,Theme_Attributes='TextBorderColor'];~
NodeFontColor OF Text := Theme_Info[Themes=Diagram_Colors,Theme_Attributes='TextFontColor'];~
NodeFontColor OF FormNode := Theme_Info[Themes=Diagram_Colors,Theme_Attributes='TextFontColor'];~
NodeInfo::ShowBorder OF Text := Include_borders;~
NodeInfo::Fill OF Text := 1;~
~
