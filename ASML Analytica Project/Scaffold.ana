Function SaveAnastyle(filename, selectedStyle: Text)
Title: SaveAnastyle
Description: Saves the selected style to an anastyle file that can be imported into other models. 
Definition: Local patch := Mod(AnalyticaVersion,100);~
Local minor := Mod(AnalyticaVersion/100,100);~
Local major := Floor(AnalyticaVersion/10k);~
~
LocalIndex colorattributes := #SetDifference(\Theme_Attributes,\'FontStyle');~
Local colorhex := NumberToText(RGB8toA(Theme_Info[Themes=Diagram_Colors,Theme_Attributes=colorattributes]),'Hexadecimal');~
~
Local graphattributes := #SetDifference(\Graph_Attributes,\'Graph_BarOutline');~
~
Local bordercolors := IF Use_node_colors_for_ = 0 ~
THEN JoinText('NodeBorderColor '&Nodes&':'&RGB8to16(Theme_Info[Themes=Diagram_Colors,Theme_Attributes='NodeBorderColor']),Nodes,separator: Chr(13))~
ELSE JoinText('NodeBorderColor '&Nodes&':'&RGB8to16(ColortoOutlineColor( Theme_Node_Colors[Themes=Diagram_Colors] ) ),Nodes,separator: Chr(13));~
~
Local setbevel := IF Diagram_Colors='Classic' THEN ~
Chr(13)&'(NodeInfo::showbevel OF Button := 1)' ELSE '';~
~
WriteTextFile(filename&'.anastyle',~
~
'{ Analytica Model '&SelectText(ID_from_title(Diagram_Colors),1,13)&'_anasty, encoding="UTF-8" }'&Chr(13)&~
'SoftwareVersion '&f"{major}.{minor}.{patch}"~
&Chr(13)&Chr(13)&~
~
'{!60300|Sys_SliderStyles := '&DEFINITION of Sys_SliderStyles&'}'&Chr(13)&~
'TableFontSize := '&Font_Size&Chr(13)&~
'AttributeFontSize := '&Font_Size~
&Chr(13)&Chr(13)&~
~
{Graph Settings}~
'Graph_LineThickness := 4'&Chr(13)&~
'Graph_ColorSeq := '&Graph_Theme_Colors[Graph_Themes=Graph_theme]&Chr(13)&~
JoinText(graphattributes&' := '&Graph_Attribute_Valu[Graph_Attributes=graphattributes],graphattributes,separator: Chr(13))&Chr(13)&~
'{!50007|Graph_BarOutline := '&Graph_Attribute_Valu[Graph_Attributes=Handle(Graph_BarOutline)]&'}'~
&Chr(13)&Chr(13)&~
~
{Arrow Settings}~
'NodeColor of ArrowClass :'&colorhex[colorattributes='ArrowBorderColor']&Chr(13)&~
'NodeColor of ArrowClass :'&colorhex[colorattributes='ArrowBorderColor']&Chr(13)&~
'{!60300|_DynamicArrowColor of ArrowClass :'&colorhex[colorattributes='ArrowBorderColor']&'}'~
&Chr(13)&Chr(13)&~
~
{Node settings}~
JoinText('NodeColor '&Nodes&':'&RGB8to16(Theme_Node_Colors[Themes=Diagram_Colors]),Nodes,separator: Chr(13))~
&Chr(13)&Chr(13)&~
bordercolors&Chr(13)&Chr(13)&~
JoinText('NodeInfo '&Nodes&':'&BorderInfo,Nodes,separator: Chr(13))~
&setbevel~
&Chr(13)&Chr(13)&~
~
{Text node settings}~
'NodeColor Text :'&RGB8to16(Theme_Info[Themes=Diagram_Colors,Theme_Attributes='TextColor'])&Chr(13)&~
'NodeBorderColor Text :'&RGB8to16(Theme_Info[Themes=Diagram_Colors,Theme_Attributes='TextBorderColor'])&Chr(13)&~
'NodeFontColor Text :'&RGB8to16(Theme_Info[Themes=Diagram_Colors,Theme_Attributes='TextFontColor'])&Chr(13)&~
'NodeFontColor FormNode :'&RGB8to16(Theme_Info[Themes=Diagram_Colors,Theme_Attributes='TextFontColor'])&Chr(13)&~
'(NodeInfo::ShowBorder OF Text := '&Include_borders&')'&Chr(13)&~
'(NodeInfo::Fill OF Text := 1)'~
&Chr(13)&Chr(13)&~
~
{Frame node settings}~
'NodeColor FrameNode :'&RGB8to16(Theme_Info[Themes=Diagram_Colors,Theme_Attributes='TextColor'])&Chr(13)&~
'NodeBorderColor FrameNode :'&RGB8to16(Theme_Info[Themes=Diagram_Colors,Theme_Attributes='TextBorderColor'])&Chr(13)&~
'NodeFontColor FrameNode :'&RGB8to16(Theme_Info[Themes=Diagram_Colors,Theme_Attributes='TextFontColor'])&Chr(13)&~
'(NodeInfo::ShowBorder OF FrameNode := '&Include_borders&')'&Chr(13)&~
'(NodeInfo::Fill OF FrameNode := 1)'~
&Chr(13)&Chr(13)&~
~
{Font styles and backgrounds}~
'( for m:=#FindObjects(class:Model,Module,LinkLibrary,LinkModule) Do FontStyle of (m) := "'&Theme_Info[Themes=Diagram_Colors,Theme_Attributes='FontStyle']&'" )'&Chr(13)&~
'( for m:=#FindObjects(class:Model,Module,LinkLibrary,LinkModule) Do DiagramColor of (m) := "'&colorhex[colorattributes='DiagramColor']&'" )'&Chr(13)&~
'( for m:=ListofHandles('&JoinText(Nodes,Nodes,',')&') Do NodeFontColor of (m) := "'&colorhex[colorattributes='NodeFontColor']&'" )'~
~
, showDialog:True)
