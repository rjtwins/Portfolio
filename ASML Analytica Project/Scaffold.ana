Button Actions_on_Load
Title: Actions on Load
Description: Displays alert for users of older versions of Analytica that some features may not work in their version.
NodeLocation: 112,504,1
NodeSize: 64,24
WindState: 2,1112,106,720,350
{!40300|ProactivelyEvaluate: 32}
OnClick: Local patch := Mod(AnalyticaVersion,100);~
Local minor := Mod(AnalyticaVersion/100,100);~
Local major := Floor(AnalyticaVersion/10k);~
local msg := "You are using Analytica version "&f"{major}.{minor}.{patch}. The following features of this library will not work or display properly:";~
~
IF AnalyticaVersion < 60300 THEN (~
	msg := msg&Chr(13)&Chr(13)&~
	" • Set all nodes buttom (requires 6.3.0 or newer)"&Chr(13)&~
	" • Arrow border colors (requires 6.3.0 or newer)"&Chr(13)&~
	" • Slider bars (requires 6.3.0 or newer)";~
	ChangeNodeVisibility(Handle(Example_Slider),'Hidden','UserInputs');~
	ChangeNodeVisibility(Handle(Set_all_nodes_to_def),'Disabled');~
	IF AnalyticaVersion < 50007 THEN (~
		msg := msg&Chr(13)&" • Bar graph outlines (requires 5.0.7 or newer)");~
	MsgBox(msg);~
);

