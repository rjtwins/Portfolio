Function RGB8to16(rgb8)
Title: RGB8to16
Description: Converts BGB 8bit text string to 16bit triple string~
'rgb(r8,g8,b8)' -> 'r16,g16,b16'~
~
If not in the correct format, just returns original string.
Definition: rgb8 := TextReplace(rgb8,' ','',all:True);~
LocalIndex rgb := ['r','g','b'];~
Local rgb16 := ParseNumber(FindInText("rgb\((\d{1,3}),(\d{1,3}),(\d{1,3})\)",rgb8,subpattern:@rgb,return:'S')) * Ratio_of_16bit_to_8b + 1;~
~
IF rgb16[@rgb=1]=null THEN rgb8 ELSE~
JoinText( f"{rgb16:I}", rgb, ',' ) ~
~
{~
IF FindInText('rgb\(.*\)',rgb8,re:1) = 0~
THEN rgb8~
ELSE ~
	Local rgb := NumberToText(ParseNumber(FindInText("\d{1,3}",rgb8,re:1,return:'S',repeat:1))* Ratio_of_16bit_to_8b + 1, 'Integer');~
	JoinText(rgb, rgb.Repeat, separator:',');~
~
}
NodeLocation: 896,48,1
NodeSize: 80,24
WindState: 2,81,157,813,451

Variable Selected_Graph_Color
Title: Selected Graph Colors
Definition: local listoftriples;~
local totalcolor;~
IF FindInText('rgb', Theme_Node_Colors[Themes=Diagram_Colors]) = 0 ~
THEN (~
	listoftriples := Theme_Node_Colors[Themes=Diagram_Colors];~
	totalcolor := Theme_Node_Colors[Themes=Diagram_Colors,Nodes=Handle(Button)]; )~
ELSE (~
	listoftriples := RGB8to16(Theme_Node_Colors[Themes=Diagram_Colors]);~
	totalcolor := RGB8to16(Theme_Node_Colors[Themes=Diagram_Colors,Nodes=Handle(Button)]);~
);~
~
'['&Jointext(listoftriples[Nodes=Node_Colors_to_Inclu], Node_Colors_to_Inclu, ',')&','&totalcolor&']';
