Button Set_all_nodes_to_def
Title: Set all nodes to default color and border styles
Description: Click to set all nodes in the parent model to use the default color and border styles. Then they will use whatever theme colors you set in this library. Otherwise, they will retain their existing (non-default) colors. Note that this will ignore any Form Nodes (i.e., input and output nodes).
NodeLocation: 592,736,1
NodeSize: 72,32
NodeInfo: 1,,,,,,,,,,,5
WindState: 2,899,117,945,697
OnClick: LocalIndex filedMods := #FindObjects(class:model,linkLibrary,linkModule);~
Local top := ArgMax( IsIn of (FiledMods) = null, filedMods );~
Local excludedFiledMods := SetDifference(\filedMods,\top);~
Local excluded := if size(#excludedFiledMods)=0 then \([]) else FindObjects(withinAny:...#excludedFiledMods);~
Local nColorChanges := 0, nTextColorChanges:=0, nInfoChanges:=0;~
Local objNodeInfo := SplitText(nodeInfo of Object,',');~
~
Local ignore := \([Handle(Te99823635),Handle(Te1697722387),Handle(Gradient),Handle(Details)]);~
Local excludedFormNodes := FindObjects(class:FormNode);~
excluded :=  SetUnion([excluded, ignore]);~
excluded :=  SetUnion([excluded, excludedFormNodes]);~
~
begin~
	LocalAlias node := #SetDifference( FindObjects(withinAny:top, class:...SysLiChoice_Cls2Rset), excluded);  ~
	LocalAlias nodeClass := HandleFromIdentifier(class of node);~
	~
	if not IsNull(nodeColor of node) then (~
		nodeColor of Node := Null;~
		nColorChanges := nColorChanges + 1;~
	);~
	if not IsNull(nodeFontColor of node) then (~
		nodeColor of Node := Null;~
		nColorChanges := nColorChanges + 1;~
	);~
	if not IsNull(nodeInfo of node) then (~
		nInfoChanges := nInfoChanges + 1;~
		nodeInfo of node :=null~
	)~
~
end;~
MsgBox( "# nodes with nodeColor cleared: " & NumberToText(nColorChanges,'Integer') & "~
# nodes with nodeFontColor cleared: " & NumberToText(nTextColorChanges) & "~
# nodes with nodeInfo cleared: " & nInfoChanges, title:"Changes made:", buttons:0)

