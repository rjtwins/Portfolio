Function ColortoOutlineColor(c: Text)
Title: ColortoOutlineColor
Description: Converts 8bit rgb color text, e.g., 'rgb(1,2,3),' or 16bit triple text, e.g., '1234,1234,1234,' into a slightly darker color for outlines.
Definition: c := TextReplace(c,' ','',all:True);~
~
LocalIndex rgb := ['r','g','b'];~
Local rgbval := ParseNumber(FindInText('(\d{1,5}),(\d{1,5}),(\d{1,5})',c,subpattern:@rgb,return:'S'));~
~
IF FindInText('rgb\(',c,re:True) THEN (~
	rgbval:= IF rgbval - 30 <= 0 THEN 0 ELSE rgbval - 30;~
	'rgb('&JoinText( f"{rgbval:I}", rgb, ',' )&')';~
)~
ELSE~
(~
	rgbval:= IF rgbval - 10000 <= 0 THEN 0 ELSE rgbval - 10000;~
	JoinText( f"{rgbval:I}", rgb, ',' );~
)
