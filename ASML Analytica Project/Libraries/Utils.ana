Function WriteJson()
Title: WriteJson
Definition: JsonTempVar := "{" & F"{JsonSchema},{JsonTempVar}" & "}";~
local currentFolder := CurrentModelFolder();~
~
local file := WriteTextFile("JsonExport\output.json", JsonTempVar, append:False, warn:True, showDialog:True);~
{JsonTempVar := RunConsoleProcess("run_jq.bat", F"Cmd/C {file}", curDir:F"{currentFolder}\JsonExport");~
MsgBox(JsonTempVar);~
{RunConsoleProcess(F"{currentFolder}JsonExport\convertToLabels.bat", curDir:F"{currentFolder}\JsonExport");}}~
~
JsonSchema := "";~
JsonTempVar := "";
