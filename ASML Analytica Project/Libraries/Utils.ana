Function Generate_Schema(indices: ... Index)
Title: Generate~
Schema
Definition: JsonSchema := '"schema":[';~
Local names;~
Local values;~
Local name := "";~
~
for index := indices do (~
	If IsNull(index) Then index ~
	Else (~
		names := IndexNames(index);~
		values := IndexValue(index);~
		name := JoinText(names);~
		{JsonSchema := JsonSchema & '{"' & name & '":' & F"{MakeJSON(values, flags:9)}" & '},';}~
		JsonSchema := JsonSchema & '"' & name & '",';~
	);~
);~
JsonSchema := TextTrim(JsonSchema, rightOnly:True, trimChars: ',');~
JsonSchema := JsonSchema & "]";
