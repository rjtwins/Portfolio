        </mxCell>
        <mxCell id="JCYes0vj1did35xagseo-1" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=25;" value="&lt;b&gt;CQRS (command query responsibility segregation) pattern:&lt;/b&gt;&lt;br&gt;&lt;a href=&quot;https://learn.microsoft.com/en-us/azure/architecture/patterns/cqrs&quot;&gt;link&lt;/a&gt;&lt;br&gt;Seperation of query (fetch data) and update data to data stores.&lt;br&gt;Data consumers should not have to know about how to store data." vertex="1">
