        </mxCell>
        <mxCell id="A7AM7nD3O5EXVxnJzTEr-14" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=25;" value="&lt;b&gt;Observer pattern:&lt;br&gt;&lt;/b&gt;&lt;a href=&quot;https://learn.microsoft.com/en-us/dotnet/standard/events/observer-design-pattern&quot;&gt;link&lt;/a&gt;&lt;br&gt;In circuit state variables are observed using the repository pattern." vertex="1">
