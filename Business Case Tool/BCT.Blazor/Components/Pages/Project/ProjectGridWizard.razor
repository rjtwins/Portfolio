}
@code {
    [CascadingParameter]
    private SelectedProjectState SelectedProjectState { get; set; }

    [CascadingParameter]
    private ProjectContentUpdatedNotifier ProjectContentUpdatedNotifier { get; set; }

    [CascadingParameter]
    private CurrentUserState CurrentUserState { get; set; }

    public Domain.Entities.ProjectGridWizard? Model { get; set; }

    private int _selectedIndex = 0;

    private bool Loading { get; set; } = false;

    protected override async Task OnInitializedAsync()
    {
        Loading = false;

        SelectedProjectState.Subscribe(this);
        ProjectContentUpdatedNotifier.Subscribe(this);

        DialogService.OnClose += DialogIsClosing;

        if (SelectedProjectState?.Value == null)
            return;

        Model = await GetProjectGridWizardUseCase.ExecuteAsync(SelectedProjectState.Value.Id);
    }

    private void DialogIsClosing(dynamic value)
    {
        SaveProjectGridWizardUseCase.ExecuteAsync(Model);
    }

    private async Task ApplyModel()
    {
        var options = new ConfirmOptions
        {
            OkButtonText = "Akkoord",
            CancelButtonText = "Annuleren",
        };

        var result = await DialogService.Confirm(
            "Let op: de eerder ingevulde waarden worden overschreven door de in dit venster ingevulde gegevens.", 
            "Akkoord om waarden te overschrijven?",
            options);

        if (result != true)
            return;

        //Apply, and  close, we save on close;
        Loading = true;
        await Task.Delay(1);
        StateHasChanged();
        await Task.Delay(1);

        //We used the wizard so we have chosen method 1;
        SelectedProjectState.Value.ChosenGridMethod = 1;
        await SaveProjectUseCase.ExecuteAsync(SelectedProjectState.Value, CurrentUserState?.Value?.Name ?? "NULL");
        await ApplyProjectGridWizardUseCase.ExecuteAsync(Model, CurrentUserState?.Value?.Name ?? "NULL");
        DialogService.Close(Model);
    }

    private void OnStartYearChanged(int _)
    {
        if(Model == null)
            return;

        var yearProperties = typeof(Domain.Entities.ProjectGridWizard).GetProperties()
            .Where(x => x.CanWrite)
            .Where(x => x.Name.ToLower().EndsWith("year"))
            .Where(x => x.Name != nameof(Domain.Entities.ProjectGridWizard.StartYear))
            .ToList();

        yearProperties.ForEach(x => x.SetValue(Model, Model.StartYear));
    }

    public void OnCompleted() { }

    public void OnError(Exception error) => throw error;

    public void OnNext(BCT.Domain.Entities.Project p)
    {
        //This should not be possible when we are in this screen!
    }

    public void OnNext(ProjectContentUpdatedEvent projectContentUpdatedEvent)
    {
        //This can be ignored.
    }

    public void Dispose()
    {
        SelectedProjectState.Unsubscribe(this);
        ProjectContentUpdatedNotifier.Unsubscribe(this);
    }
}
