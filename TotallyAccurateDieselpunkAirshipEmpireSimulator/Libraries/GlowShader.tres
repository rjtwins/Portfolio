code = "shader_type canvas_item;
render_mode blend_add;

uniform float Glow : hint_range(1.0, 100.0, 0.10000000149012) = 2.0;



void fragment() {
// Input:5
	vec4 n_out5p0 = COLOR;
	float n_out5p1 = n_out5p0.r;
	float n_out5p2 = n_out5p0.g;
	float n_out5p3 = n_out5p0.b;


// FloatParameter:4
	float n_out4p0 = Glow;


// FloatOp:8
	float n_out8p0 = n_out5p1 * n_out4p0;


// FloatOp:9
	float n_out9p0 = n_out5p2 * n_out4p0;


// FloatOp:10
	float n_out10p0 = n_out5p3 * n_out4p0;


// VectorCompose:7
	vec3 n_out7p0 = vec3(n_out8p0, n_out9p0, n_out10p0);


// Output:0
	COLOR.rgb = n_out7p0;


}

void light() {
// Vector3Constant:3
	vec3 n_out3p0 = vec3(2.000000, 2.000000, 2.000000);


// BooleanConstant:2
	bool n_out2p0 = true;


// Output:0
	LIGHT.rgb = n_out3p0;
	LIGHT.a = (n_out2p0 ? 1.0 : 0.0);


}
"
