code = "shader_type canvas_item;
render_mode blend_mix;

uniform float force = 2;



void fragment() {
// Input:2
	vec2 n_out2p0 = UV;


// Vector2Constant:3
	vec2 n_out3p0 = vec2(0.500000, 0.500000);


// VectorOp:7
	vec2 n_out7p0 = n_out2p0 - n_out3p0;


// VectorFunc:12
	vec2 n_out12p0 = normalize(n_out7p0);


// FloatParameter:13
	float n_out13p0 = force;


// VectorOp:15
	vec2 n_out15p0 = n_out12p0 * vec2(n_out13p0);


// VectorOp:8
	vec2 n_out8p0 = n_out2p0 - n_out15p0;


	vec4 n_out6p0;
// Texture2D:6
	n_out6p0 = texture(TEXTURE, n_out8p0);


// Output:0
	COLOR.rgb = vec3(n_out6p0.xyz);


}
"
