; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Totally Accurate Diesel Punk Airship Empire Simulator"
run/main_scene="uid://ckwkide7toaad"
config/features=PackedStringArray("4.5", "C#", "Forward Plus")

[autoload]

Init="*res://Global/init.tscn"
Globals="res://Global/globals.cs"

[debug_draw_3d]

settings/addon_root_folder="res://addons/debug_draw_3d"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/size/initial_position_type=3
window/size/resizable=false
window/size/borderless=true
window/stretch/mode="canvas_items"
window/per_pixel_transparency/allowed=true
window/vsync/vsync_mode=2

[dotnet]

project/assembly_name="TheGame"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot-polyliner/plugin.cfg")

[gui]

common/snap_controls_to_pixels=false
theme/default_font_antialiasing=2
theme/default_font_generate_mipmaps=true
theme/custom_font="uid://bdjofhoc354cb"

[importer_defaults]

texture={
"mipmaps/generate": true,
"process/fix_alpha_border": false
}
texture_atlas={
"trim_alpha_border_from_region": false
}

