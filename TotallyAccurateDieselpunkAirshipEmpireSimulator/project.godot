[layer_names]

2d_physics/layer_2="EditorCollision"
3d_physics/layer_2="EditorCollisionDetection"
2d_physics/layer_3="EditorSnapping"
3d_physics/layer_3="EditorConnectionDetection"
2d_physics/layer_4="SmallHardPoint"
3d_physics/layer_4="WorldBulletCollision"
2d_physics/layer_5="MediumHardPoint"
2d_physics/layer_6="LargeHardPoint"
2d_physics/layer_7="HardPointCollision1"
2d_physics/layer_8="HardPointCollision2"
2d_physics/layer_9="HardPointCollision3"
2d_physics/layer_10="BattleBullet"
2d_physics/layer_11="AircraftHardpoint"
2d_physics/layer_19="GameWorldSelectionArea"
2d_physics/layer_20="GameWorldUICollision"
2d_physics/layer_31="IR"
2d_physics/layer_32="Radar"

[physics]

3d/default_linear_damp=0.0
3d/default_angular_damp=0.0
2d/default_linear_damp=0.0
2d/default_angular_damp=0.0

[rendering]

lights_and_shadows/directional_shadow/soft_shadow_filter_quality=5
anti_aliasing/quality/msaa_2d=1
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/screen_space_aa=1
